@model PCShop.Models.Order

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            @if (Model.IsPaid)
            {
                <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
                <h2 class="mt-3 text-success">@ViewBag.Message</h2>
            }
            else
            {
                <i class="bi bi-clock-history text-warning" style="font-size: 4rem;"></i>
                <h2 class="mt-3 text-warning">@ViewBag.Message</h2>
            }
            
            <p class="lead mt-3">Thank you for your order, <strong>@Model.CustomerName</strong>!</p>
            <p>We've sent a confirmation email to <strong>@Model.CustomerEmail</strong> (via Observer Pattern).</p>
        </div>
    </div>

    <div class="row justify-content-center mt-5">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-dark text-white d-flex justify-content-between">
                    <span>Order Details</span>
                    <span>Date: @Model.OrderDate.ToString("g")</span>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <h6 class="mb-2 border-bottom pb-2">Delivery Address:</h6>
                            <div>@Model.ShippingAddress</div>
                            <div>Phone: @Model.PhoneNumber</div>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="mb-2 border-bottom pb-2">Payment Details:</h6>
                            <div>Method: <strong>@Model.PaymentMethod</strong></div>
                            <div>Status: <span class="badge @(Model.IsPaid ? "bg-success" : "bg-warning")">@Model.Status</span></div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm pb-0 mb-0">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>Product @item.ProductId</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                    </tr>
                                }
                                
                                @if (Model.ServicesFee > 0)
                                {
                                    <tr class="table-light">
                                        <td colspan="2">
                                            <small class="text-muted">Services (Decorator Pattern):<br/>@Model.ServicesDetails</small>
                                        </td>
                                        <td class="text-end">@Model.ServicesFee.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold fs-5">
                                    <td colspan="2" class="text-end">Total Amount:</td>
                                    <td class="text-end text-primary">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
                <div class="card-footer text-center py-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Return to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
