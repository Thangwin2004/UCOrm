@model PCShop.Models.Order

@{
    ViewData["Title"] = "Checkout";
    var paymentMethods = ViewBag.PaymentMethods as List<string>;
}

<h2>Checkout</h2>
<hr />

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="card-title mb-0">Shipping Information</h5>
            </div>
            <div class="card-body">
                <form asp-action="PlaceOrder" method="post" id="checkoutForm">
                    <div class="mb-3">
                        <label for="CustomerName" class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="CustomerName" name="CustomerName" required>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="CustomerEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="CustomerEmail" name="CustomerEmail" required>
                        </div>
                        <div class="col-md-6">
                            <label for="PhoneNumber" class="form-label">Phone</label>
                            <input type="tel" class="form-control" id="PhoneNumber" name="PhoneNumber" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="ShippingAddress" class="form-label">Shipping Address</label>
                        <textarea class="form-control" id="ShippingAddress" name="ShippingAddress" rows="3" required></textarea>
                    </div>

                    <hr />
                    <h5 class="mb-3">Additional Services (Decorator Pattern)</h5>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="addWarranty" name="addWarranty" value="true">
                        <label class="form-check-label" for="addWarranty">
                            Extended 2-Year Warranty (+$50)
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="addExpress" name="addExpress" value="true">
                        <label class="form-check-label" for="addExpress">
                            Express Shipping (+$25)
                        </label>
                    </div>
                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="addAssembly" name="addAssembly" value="true">
                        <label class="form-check-label" for="addAssembly">
                            Pro PC Assembly Service (+$150)
                        </label>
                    </div>

                    <hr />
                    <h5 class="mb-3">Payment Method (Strategy & Adapter Pattern)</h5>
                    <div class="mb-4">
                        @foreach (var method in paymentMethods)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethodName" id="@method" value="@method" required>
                                <label class="form-check-label" for="@method">
                                    @method
                                </label>
                            </div>
                        }
                    </div>

                    <button type="submit" class="btn btn-lg btn-success w-100">Place Order</button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card shadow-sm border-info">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">Pricing Rules (Strategy Pattern)</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush mb-0">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Regular Orders
                        <span class="badge bg-secondary rounded-pill">Full Price</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Orders > $1000
                        <span class="badge bg-warning text-dark rounded-pill">-15% Student</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Orders > $2000
                        <span class="badge bg-danger rounded-pill">-20% VIP</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
