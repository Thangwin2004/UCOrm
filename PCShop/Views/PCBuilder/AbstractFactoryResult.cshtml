@{
    ViewData["Title"] = "Platform Build Result";
    var cpu = ViewBag.CPU as PCShop.Models.Product;
    var mobo = ViewBag.Motherboard as PCShop.Models.Product;
    var ram = ViewBag.RAM as PCShop.Models.Product;
}

<div class="text-center mb-4">
    <h2 class="text-primary"><i class="bi bi-diagram-3-fill"></i> Abstract Factory Result</h2>
    <p class="lead">System generated an optimized baseline for <strong>@ViewBag.Platform</strong></p>
</div>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info">@ViewBag.Message</div>
}

<div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
    <!-- CPU -->
    <div class="col">
        <div class="card h-100 shadow-sm border-primary">
            <div class="card-header bg-primary text-white">CPU</div>
            <div class="card-body text-center">
                <img src="@cpu.ImageUrl" class="mb-3" style="height: 120px; object-fit: contain;">
                <h5 class="card-title">@cpu.Name</h5>
                <p class="card-text text-muted small">@cpu.Description</p>
                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    <input type="hidden" name="productId" value="@cpu.Id" />
                    <!-- Since these might not trace back to DB IDs properly in this quick demo, we might need a separate way or just show details -->
                    <div class="fw-bold mt-2">@cpu.Price.ToString("C")</div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Motherboard -->
    <div class="col">
        <div class="card h-100 shadow-sm border-secondary">
            <div class="card-header bg-secondary text-white">Motherboard</div>
            <div class="card-body text-center">
                <img src="@mobo.ImageUrl" class="mb-3" style="height: 120px; object-fit: contain;">
                <h5 class="card-title">@mobo.Name</h5>
                <p class="card-text text-muted small">@mobo.Description</p>
                <div class="fw-bold mt-2">@mobo.Price.ToString("C")</div>
            </div>
        </div>
    </div>

    <!-- RAM -->
    <div class="col">
        <div class="card h-100 shadow-sm border-success">
            <div class="card-header bg-success text-white">Memory (RAM)</div>
            <div class="card-body text-center">
                <img src="@ram.ImageUrl" class="mb-3" style="height: 120px; object-fit: contain;">
                <h5 class="card-title">@ram.Name</h5>
                <p class="card-text text-muted small">@ram.Description</p>
                <div class="fw-bold mt-2">@ram.Price.ToString("C")</div>
            </div>
        </div>
    </div>
</div>

<div class="text-center">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to PC Builder</a>
    <a asp-controller="Product" asp-action="Index" class="btn btn-primary">Browse Full Catalog</a>
</div>
