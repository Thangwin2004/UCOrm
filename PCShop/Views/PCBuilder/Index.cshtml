@{
    ViewData["Title"] = "PC Builder";
}

<div class="text-center mb-5">
    <h2>PC Builder System</h2>
    <p class="lead">Demoing Abstract Factory and Builder Patterns</p>
</div>

<div class="row g-4">
    <!-- Abstract Factory Card -->
    <div class="col-md-6">
        <div class="card h-100 shadow border-primary">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Pattern: Abstract Factory</h4>
            </div>
            <div class="card-body text-center p-4">
                <i class="bi bi-diagram-3-fill text-primary" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Platform Generator</h5>
                <p class="text-muted">Generates a family of related products (CPU, Motherboard, RAM) guaranteed to be compatible.</p>
                
                <form asp-action="GeneratePlatformBuild" method="post" class="mt-4">
                    <div class="d-grid gap-3">
                        <button type="submit" name="platform" value="Intel" class="btn btn-primary btn-lg">Generate Intel Build</button>
                        <button type="submit" name="platform" value="AMD" class="btn btn-danger btn-lg">Generate AMD Build</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Builder Card -->
    <div class="col-md-6">
        <div class="card h-100 shadow border-success">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">Pattern: Builder</h4>
            </div>
            <div class="card-body text-center p-4">
                <i class="bi bi-tools text-success" style="font-size: 3rem;"></i>
                <h5 class="mt-3">Auto-Configure System</h5>
                <p class="text-muted">Uses a Director to step-by-step construct a complex PC object using concrete builders.</p>
                
                <form asp-action="GenerateAutoBuild" method="post" class="mt-4">
                    <div class="d-grid gap-3">
                        <button type="submit" name="buildType" value="HighEnd" class="btn btn-success btn-lg">Build High-End 4K PC</button>
                        <button type="submit" name="buildType" value="Budget" class="btn btn-outline-success btn-lg">Build Budget 1080p PC</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
