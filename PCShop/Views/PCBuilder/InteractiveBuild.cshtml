@model List<PCShop.Models.CategoryType>
@{
    ViewData["Title"] = "Interactive PC Builder";
}

<div class="row mb-4 pt-3">
    <div class="col-12 text-center">
        <h2 class="display-5 fw-bold text-primary"><i class="bi bi-pc-display"></i> Custom PC Builder</h2>
        <p class="lead text-muted">Select components step by step to build your perfect custom computer.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Component Selector Table -->
    <div class="col-lg-8">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center p-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-list-columns-reverse me-2"></i> Build Configuration</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="min-width: 600px;">
                        <tbody>
                            @foreach(var cat in Model)
                            {
                                <tr id="row-@cat" class="bg-white border-bottom">
                                    <td class="col-2 py-3 px-4 fw-bold text-secondary text-uppercase" style="font-size: 0.85rem; letter-spacing: 0.5px;">@cat</td>
                                    <td class="col-7" id="desc-@cat">
                                        <span class="text-muted"><i class="bi bi-info-circle me-1"></i> Please select a @cat...</span>
                                    </td>
                                    <td class="col-2 text-end text-danger fw-bold fs-5" id="price-@cat" data-val="0">0 ₫</td>
                                    <td class="col-1 text-center pe-4">
                                        <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm" onclick="openSelectionModal('@cat')">
                                            <i class="bi bi-plus"></i> Choose
                                        </button>
                                        <input type="hidden" class="build-item" data-category="@cat" value="" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
        <!-- Legacy Demos -->
        <div class="mt-5 p-4 bg-light rounded shadow-sm text-center">
            <h5 class="text-muted mb-3">Try Automated Build Patterns</h5>
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="AbstractFactoryDemo" class="btn btn-outline-secondary">Abstract Factory Demo</a>
                <a asp-action="BuilderDemo" class="btn btn-outline-secondary">Builder Pattern Demo</a>
            </div>
        </div>
    </div>

    <!-- Summary Sidebar -->
    <div class="col-lg-4">
        <div class="card shadow border-0 rounded-3 position-sticky" style="top: 2rem;">
            <div class="card-header bg-primary text-white p-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-receipt me-2"></i> Summary & Total</h5>
            </div>
            <div class="card-body p-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <span class="text-muted fs-6 text-uppercase fw-bold">Estimated Cost</span>
                    <span class="fs-3 text-danger fw-bold" id="total-price">0 ₫</span>
                </div>
                
                <button class="btn btn-success w-100 btn-lg shadow" onclick="addBuildToCart()" style="font-weight: 600;">
                    <i class="bi bi-cart-plus-fill me-2"></i> Add Configuration to Cart
                </button>
                <div class="text-center mt-3">
                    <small class="text-muted"><i class="bi bi-shield-check"></i> 100% Compatibility Guaranteed</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Selection Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="modalTitle"><i class="bi bi-search me-2"></i> Select Component</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light p-4" id="modalContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentCategory = '';
        const modal = new bootstrap.Modal(document.getElementById('productModal'));

        function openSelectionModal(category) {
            currentCategory = category;
            document.getElementById('modalTitle').innerHTML = '<i class="bi bi-box me-2"></i> Select ' + category;
            document.getElementById('modalContent').innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div></div>';
            modal.show();

            fetch(`/PCBuilder/GetProductsByCategory?category=${category}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('modalContent').innerHTML = html;
                })
                .catch(err => {
                    document.getElementById('modalContent').innerHTML = '<div class="alert alert-danger shadow-sm"><i class="bi bi-exclamation-triangle-fill"></i> Failed to load products. Check console for details.</div>';
                });
        }

        function selectProduct(id, name, price, imageUrl) {
            // Update row UI
            const descTd = document.getElementById('desc-' + currentCategory);
            const priceTd = document.getElementById('price-' + currentCategory);
            const hiddenInput = document.querySelector(`input[data-category='${currentCategory}']`);
            
            descTd.innerHTML = `
                <div class="d-flex align-items-center p-2 rounded bg-light border border-primary border-opacity-25 shadow-sm">
                    <div class="bg-white p-1 rounded border shadow-sm me-3" style="width: 60px; height: 60px; display: flex; align-items: center; justify-content: center;">
                        <img src="${imageUrl}" alt="${name}" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                    </div>
                    <div>
                        <span class="fw-bold d-block text-dark" style="font-size: 1.05rem;">${name}</span>
                        <span class="badge bg-primary mt-1">Selected</span>
                    </div>
                </div>`;
            
            priceTd.innerText = price.toLocaleString('en-US', { style: 'currency', currency: 'USD' }).replace('$', '$ ');
            priceTd.setAttribute('data-val', price);
            priceTd.classList.remove('text-muted');
            priceTd.classList.add('text-danger');
            
            hiddenInput.value = id;
            
            // Highlight the row temporarily
            const row = document.getElementById('row-' + currentCategory);
            row.classList.add('table-primary');
            setTimeout(() => row.classList.remove('table-primary'), 1000);
            
            updateTotal();
            modal.hide();
        }

        function updateTotal() {
            let total = 0;
            document.querySelectorAll('td[id^="price-"]').forEach(td => {
                const val = parseFloat(td.getAttribute('data-val')) || 0;
                total += val;
            });
            document.getElementById('total-price').innerText = total.toLocaleString('en-US', { style: 'currency', currency: 'USD' }).replace('$', '$ ');
        }

        function addBuildToCart() {
            const inputs = document.querySelectorAll('.build-item');
            const ids = [];
            inputs.forEach(input => {
                if(input.value) ids.push(parseInt(input.value));
            });

            if (ids.length === 0) {
                alert("Please select at least one component to add to cart.");
                return;
            }

            fetch('/Cart/AddMultipleToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(ids)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = data.redirectUrl;
                } else {
                    alert("Error adding to cart.");
                }
            })
            .catch(err => alert("Error communicating with server."));
        }
    </script>
}
