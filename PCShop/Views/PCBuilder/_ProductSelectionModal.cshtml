@model IEnumerable<PCShop.Models.Product>

<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-box-seam display-4"></i>
            <p class="mt-3 fs-5">No products found for this category at the moment.</p>
        </div>
    }
    @foreach (var p in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 product-card position-relative overflow-hidden">
                <div class="row g-0 h-100 align-items-center p-2">
                    <div class="col-4 text-center">
                        <img src="@p.ImageUrl" class="img-fluid rounded" alt="@p.Name" style="max-height: 80px; object-fit: contain;">
                    </div>
                    <div class="col-8">
                        <div class="card-body p-2 d-flex flex-column justify-content-between h-100">
                            <div>
                                <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">@p.Brand</small>
                                <h6 class="card-title fw-bold mb-1 text-dark" style="font-size: 0.95rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@p.Name</h6>
                            </div>
                            <div class="mt-2">
                                <p class="text-danger fw-bold mb-2 fs-5">@p.Price.ToString("C").Replace("$", "$ ")</p>
                                <button class="btn btn-outline-primary btn-sm w-100 fw-bold rounded-pill" onclick="selectProduct(@p.Id, '@p.Name.Replace("'", "\\'")', @p.Price, '@p.ImageUrl')">
                                    <i class="bi bi-check2-circle"></i> Select
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .product-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid rgba(0,0,0,.05) !important;
    }
    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.1) !important;
        border-color: rgba(13, 110, 253, 0.3) !important;
    }
</style>
