@model PCShop.Models.PCBuild

@{
    ViewData["Title"] = "Auto Build Result";
    var components = Model.GetComponents();
}

<div class="text-center mb-4">
    <h2 class="text-success"><i class="bi bi-tools"></i> Builder Pattern Result</h2>
    <p class="lead">System assembled a compatible build: <strong>@Model.BuildName</strong></p>
</div>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
        <br/>
        <small class="text-muted">Validation: @Model.ValidateBuild()</small>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between">
        <h5 class="mb-0">Selected Components</h5>
        <h5 class="mb-0">Estimated Total: @Model.TotalPrice.ToString("C")</h5>
    </div>
    
    <div class="list-group list-group-flush">
        @foreach (var item in components)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                <div class="d-flex align-items-center">
                    <img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: contain;" class="me-3 border rounded p-1">
                    <div>
                        <h6 class="mb-0">@item.Category: @item.Name</h6>
                        <small class="text-muted">@item.Brand</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="fw-bold">@item.Price.ToString("C")</span>
                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Add this item to cart"><i class="bi bi-cart-plus"></i> Add</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div class="text-center">
    <a asp-action="Index" class="btn btn-outline-secondary">Build Another PC</a>
    
    <!-- Helper form to add all to cart using Command Pattern iteratively -->
    @* In a real app we might create a macro command "AddMultipleToCartCommand" *@
    <form asp-controller="Cart" asp-action="Index" method="get" class="d-inline ms-2">
        <button type="submit" class="btn btn-success btn-lg">View Cart</button>
    </form>
</div>
