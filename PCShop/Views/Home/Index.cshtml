@model IEnumerable<PCShop.Models.Product>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center mb-5">
    <h1 class="display-4 fw-bold">Welcome to PCShop</h1>
    <p class="lead">Build your dream PC or buy premium gear with our 10 Design Pattern powered system!</p>
    
    <div class="mt-4">
        <a asp-controller="PCBuilder" asp-action="Index" class="btn btn-primary btn-lg px-5 me-2">Go to PC Builder (Builder Pattern)</a>
        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">Browse Components</a>
    </div>
</div>

<h3 class="mb-4 border-bottom pb-2">Featured Products (From Database)</h3>

<div class="row row-cols-1 row-cols-md-4 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@item.ImageUrl" class="card-img-top p-3" alt="@item.Name" style="height: 200px; object-fit: contain;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-truncate" title="@item.Name">@item.Name</h5>
                    <p class="card-text text-muted small">@item.Brand | @item.Category</p>
                    <h6 class="card-subtitle mb-2 fw-bold text-primary mt-auto">@item.Price.ToString("C")</h6>
                    
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-3">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-primary w-100">Add to Cart</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
